       if(g_modtab) { uint32_t m1=sr_modv[tC1]; if(m1) PUTLE16(&psxDst[(i<<dshift)+j],m1); } else GetTextureTransColG(&psxDst[(i<<dshift)+j],sr_clutv[(tC1)]);
