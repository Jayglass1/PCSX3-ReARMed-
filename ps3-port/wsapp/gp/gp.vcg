/* PS1 GPU primitive vertex program: positions are native VRAM pixels (0..1024, 0..512) */
void main(float2 pos : POSITION, float4 col : COLOR0, float2 uv : TEXCOORD0,
          float4 pg : TEXCOORD1, float4 md : TEXCOORD2, float4 tw : TEXCOORD3,
          out float4 oPos : POSITION, out float4 oCol : COLOR0, out float2 oUv : TEXCOORD0,
          out float4 oPg : TEXCOORD1, out float4 oMd : TEXCOORD2, out float4 oTw : TEXCOORD3)
{
    oPos = float4(pos.x * (1.0f / 512.0f) - 1.0f, 1.0f - pos.y * (1.0f / 256.0f), 0.0f, 1.0f);
    oCol = col;
    oUv = uv;
    oPg = pg;
    oMd = md;
    oTw = tw;
}
